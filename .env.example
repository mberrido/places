# Copy to .env (Docker) or .env.local (dev) and fill in.
# Wrap values containing $, # or spaces in 'single quotes'.

# --- First account (only read when the database is first set up) -------------
# The app has one account per household, each with its own password, places,
# inbox and Shortcut token, managed in Settings. These set up the first
# (admin) account; after that, change things in Settings, not here.
APP_PASSWORD=
# Names shown as "added by", e.g. HOUSEHOLD_MEMBERS=Mal,Sam
HOUSEHOLD_MEMBERS=
# The first account's Shortcut token. Leave blank to generate one (see Settings).
INGEST_TOKEN=
# Optional: cookie signing key. If blank, one is generated and kept in the data folder.
SESSION_SECRET=

# --- APIs (server-side only; never sent to the browser) -----------------------
# Google Maps Platform key with "Places API (New)" enabled. See README.
GOOGLE_PLACES_API_KEY=
# Anthropic API key for Instagram caption / screenshot extraction (stage 3+).
ANTHROPIC_API_KEY=
# Optional: Meta app token for Instagram oEmbed ("APP_ID|CLIENT_TOKEN").
META_OEMBED_TOKEN=

# --- Storage -----------------------------------------------------------------
# Local dev defaults: ./data/places.db and ./data/backups. The Docker image sets
# DATABASE_PATH=/data/places.db and BACKUP_DIR=/backups itself; leave these
# commented out in the NAS .env.
# DATABASE_PATH=./data/places.db
# BACKUP_DIR=./data/backups
# How many nightly backups to keep (default 14).
# BACKUP_KEEP=14

# --- Synology user/group that owns the data and backup folders ----------------
# Find them over SSH with:  id <your-dsm-username>
PUID=1026
PGID=100
